# ==============================================================================
# Vercel Frontend Environment Variables
# ==============================================================================
# In Vercel Project Settings -> Environment Variables:
# Set VITE_API_URL to your deployed Render backend service URL.
# Example: https://ai-crm-backend.onrender.com
# Note: In local development, leave this empty to use the Vite proxy (localhost:8081).
VITE_API_URL=
